{
  "scenario_id": "S6_combined_stress",
  "description": "30 UEs + retries + partial observability. Hardest scenario for baselines.",
  "duration_seconds": 1200,
  "observability_mode": "pcap_only",
  "concurrency_target": 30,
  "retry_profile": {
    "enabled": true,
    "max_retries_per_flow": 3
  },
  "capture": {
    "containers_for_logs": ["amf", "ueransim"],
    "pcap_targets": [
      { "container": "upf", "interface": "eth0", "filter": "sctp or udp port 2152 or tcp port 8000" }
    ],
    "normalization_drop_fields": ["supi", "amf_ue_ngap_id", "ran_ue_ngap_id"]
  },
  "provision": {
    "subscriber_count": 30,
    "base_imsi": 208930000000001
  },
  "actions": [
    { "at_second": 40,  "command": "docker exec -d ueransim ./nr-ue -c ./config/uecfg.yaml -n 10" },
    { "at_second": 70,  "command": "docker exec -d ueransim ./nr-ue -c /ueransim/config/ue-group-2.yaml -n 10" },
    { "at_second": 100, "command": "docker exec -d ueransim ./nr-ue -c /ueransim/config/ue-group-3.yaml -n 10" },
    { "at_second": 200, "command": "docker pause smf || true" },
    { "at_second": 220, "command": "docker unpause smf || true" },
    { "at_second": 400, "command": "docker exec -d ueransim ./nr-ue -c ./config/uecfg.yaml -n 10" },
    { "at_second": 600, "command": "docker pause ausf || true" },
    { "at_second": 615, "command": "docker unpause ausf || true" },
    { "at_second": 700, "command": "docker exec -d ueransim ./nr-ue -c /ueransim/config/ue-group-2.yaml -n 10" }
  ]
}
