{
  "scenario_id": "S3_high_interleave",
  "description": "30 UEs in 3 staggered batches of 10, creating high interleaving of control-plane procedures.",
  "duration_seconds": 900,
  "observability_mode": "full",
  "concurrency_target": 30,
  "retry_profile": {
    "enabled": false,
    "max_retries_per_flow": 0
  },
  "capture": {
    "containers_for_logs": ["amf", "smf", "upf", "ausf", "udm", "udr", "nrf", "ueransim"],
    "pcap_targets": [
      { "container": "amf",  "interface": "eth0", "filter": "sctp port 38412 or tcp port 8000", "role": "n2_sbi" },
      { "container": "smf",  "interface": "eth0", "filter": "udp port 8805 or tcp port 8000",  "role": "n4_sbi" },
      { "container": "upf",  "interface": "eth0", "filter": "udp port 2152 or udp port 8805",  "role": "n3_n4" }
    ]
  },
  "provision": {
    "subscriber_count": 30,
    "base_imsi": 208930000000001
  },
  "actions": [
    { "at_second": 30,  "command": "docker exec -d ueransim ./nr-ue -c ./config/uecfg.yaml -n 10" },
    { "at_second": 60,  "command": "docker exec -d ueransim ./nr-ue -c /ueransim/config/ue-group-2.yaml -n 10" },
    { "at_second": 90,  "command": "docker exec -d ueransim ./nr-ue -c /ueransim/config/ue-group-3.yaml -n 10" },
    { "at_second": 300, "command": "docker exec ueransim ping -c 3 -W 2 -I uesimtun0 8.8.8.8 || true" }
  ]
}
