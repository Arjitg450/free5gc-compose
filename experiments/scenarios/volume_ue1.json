{
  "scenario_id": "volume_ue1",
  "description": "Volume experiment: 1 UE, same duration and capture for log/pcap scaling analysis.",
  "duration_seconds": 300,
  "observability_mode": "full",
  "concurrency_target": 1,
  "retry_profile": {"enabled": false, "max_retries_per_flow": 0},
  "capture": {
    "containers_for_logs": ["amf", "smf", "upf", "ausf", "udm", "udr", "nrf", "ueransim"],
    "pcap_targets": [
      {"container": "amf", "interface": "eth0", "filter": "sctp port 38412 or tcp port 8000", "role": "n2_sbi"},
      {"container": "smf", "interface": "eth0", "filter": "udp port 8805 or tcp port 8000", "role": "n4_sbi"},
      {"container": "upf", "interface": "eth0", "filter": "udp port 2152 or udp port 8805", "role": "n3_n4"}
    ]
  },
  "provision": {"subscriber_count": 1, "base_imsi": 208930000000001},
  "actions": [
    {"at_second": 10, "command": "docker exec -d ueransim ./nr-ue -c ./config/uecfg.yaml -n 1"},
    {"at_second": 90, "command": "docker exec ueransim ping -c 5 -I uesimtun0 8.8.8.8 || true"}
  ]
}
